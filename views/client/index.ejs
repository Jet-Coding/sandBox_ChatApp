<!DOCTYPE html>
<html lang="en">
	<%- include('../partials/clientHead') %>
	<body>
		<div class="chat-app">
			<!-- Left Navigation / Conversation List -->
			<aside class="left-sidebar">
				<div class="left-sidebar-header">
					<div class="user-profile">
						<img
							src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop"
							alt="Avatar"
							class="avatar" />
						<div class="user-details">
							<h3><%= (typeof user !== 'undefined' && user) ? (user.username || user.email) : 'Guest' %></h3>
							<span class="status-indicator online">Online</span>
						</div>
					</div>

					<!-- Logout Form -->
					<form action="/auth/logout" method="POST" style="display: inline">
						<button type="submit" class="btn-icons" title="Logout">
							<i class="fa-solid fa-right-from-bracket"></i>
						</button>
					</form>
				</div>

				<div class="left-search-bar">
					<i class="fa-solid fa-magnifying-glass"></i>
					<input type="text" placeholder="Search conversations..." />
				</div>

				<!-- Navigation List (FIXED HTML STRUCTURE) -->
				<nav class="chat-list">
					<% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
						<% usersList.forEach((user, index) => { %>
							<div class="chat-item <%= index === 0 ? 'active' : '' %>" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
								<img
									src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop"
									alt="<%= user.username %>'s Avatar"
									class="avatar" />
								<div class="chat-info">
									<div class="chat-top">
										<span class="name"><%= user.username %></span>
										<span class="time">Active</span>
									</div>
									<p class="preview"><%= user.email %></p>
								</div>
							</div>
						<% }); %>
					<% } else { %>
						<div class="chat-item-empty" style="padding: 15px; text-align: center; color: #888;">
							<p>No other users found.</p>
						</div>
					<% } %>
				</nav>
			</aside>

			<!-- Center Active Chat Workspace -->
			<main class="chat-main">
				<header class="chat-header">
					<% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
						<% usersList.forEach((user, index) => { %>
						<div class="active-user <%= index === 0 ? 'active' : ''  %>" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
							<img
								src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop"
								alt="<%= user.username %>'s Avatar"
								class="avatar" />
							<div>
								<h3 class="name"><%= user.username %></h3>
								<span class="subtext">Active now</span>
							</div>
						</div>
						<div class="header-actions">
							<button class="btn-icons" title="Start Call">
								<i class="fa-solid fa-phone"></i>
							</button>
							<button class="btn-icons" title="Video Call">
								<i class="fa-solid fa-video"></i>
							</button>
							<button class="btn-icons" id="toggle-info" title="Toggle Info">
								<i class="fa-solid fa-circle-info"></i>
							</button>
						</div>
						<% }); %>
					<% } %>
				</header>

				<section class="message-feed" id="message-feed">
					<% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
						<% usersList.forEach((user, index) => { %>
						<div class="message-group incoming <%= index === 0 ? 'active' : ''  %>" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
							<img
								src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop"
								alt="<%= user.username %>'s Avatar"
								class="avatar-small" />
							<div class="bubble-wrapper">
								<div class="bubble">
									Hey! Did you review the latest Math assignment?
								</div>
								<span class="timestamp">10:40 AM</span>
							</div>
						</div>

						<div class="message-group outgoing">
							<div class="bubble-wrapper">
								<div class="bubble">
									Yes, I just finished step 3! Sending over the details now.
								</div>
								<span class="timestamp">10:42 AM</span>
							</div>
						</div>
						<% }); %>
					<% } %>
				</section>

				<footer class="chat-composer">
					<form id="chat-form">
						<button type="button" class="btn-icons" title="Attach file">
							<i class="fa-solid fa-paperclip"></i>
						</button>
						<input
							type="text"
							id="message-input"
							placeholder="Type a message..."
							autocomplete="off"
							required />
						<button type="button" class="btn-icons" title="Emoji">
							<i class="fa-regular fa-face-smile"></i>
						</button>
						<button type="submit" class="btn-send" title="Send">
							<i class="fa-solid fa-paper-plane"></i>
						</button>
					</form>
				</footer>
			</main>

			<aside class="sidebar-right" id="sidebar-right">
				<% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
					<% usersList.forEach((user, index) => { %>
					<div class="info-profile <%= index === 0 ? 'active' : ''  %>" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
						<img
							src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop"
								alt="<%= user.username %>'s Avatar"
							class="avatar-large" />
						<h3 class="name"><%= user.username %></h3>
						<p>Student · Grade 10</p>
					</div>

					<div class="shared-section">
						<h4>Shared Files</h4>
						<ul class="file-list">
							<li>
								<i class="fa-solid fa-file-pdf"></i>
								<span>algebra_notes.pdf</span>
							</li>
							<li>
								<i class="fa-solid fa-file-image"></i> <span>diagram_v1.png</span>
							</li>
						</ul>
					</div>
					<% }); %>
				<% } %>
			</aside>
		</div>

		<script>
			window.currentUser = <%- JSON.stringify(typeof user !== 'undefined' && user ? (user.username || user.email) : 'Client') %>;
			window.currentUserId = <%- JSON.stringify(typeof user !== 'undefined' && user ? user.id : 'client_guest') %>;
		</script>

		<script src="/socket.io/socket.io.js"></script>
		<script src="/js/client.js"></script>
	</body>
</html>